<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Mcp.Cloud.HostedAuth</PackageId>
    <Title>Umbraco MCP Cloud Hosted Auth</Title>
    <Description>
      Wires hosted Umbraco MCP Cloudflare Workers into the backoffice OAuth flow:
      registers the workers as OpenIddict authorization_code clients, fixes
      cold-start SSO on the management API authorize endpoint, and keeps MCP
      sessions alive across backoffice logins without disabling single-session
      enforcement globally.
    </Description>
    <PackageTags>umbraco;umbraco-cloud;mcp;oauth;openiddict</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings Umbraco.Cms.Core/Web.Common, UserLoginSuccessNotification, and the
         OpenIddict abstractions (IOpenIddictApplicationManager / IOpenIddictTokenManager)
         transitively. Min 17.3.0 is the first to expose
         SecuritySettings.GetUserAllowConcurrentLogins; min-bounded so the
         consuming project's CMS version wins. -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.3.0, 18.0.0)" />
  </ItemGroup>

</Project>
