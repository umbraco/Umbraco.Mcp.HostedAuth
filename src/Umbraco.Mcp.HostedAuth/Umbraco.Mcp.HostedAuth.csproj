<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Mcp.HostedAuth</PackageId>
    <Title>Umbraco MCP Hosted Auth</Title>
    <Description>
      Wires hosted Umbraco MCP Cloudflare Workers into the backoffice OAuth flow,
      on Umbraco Cloud and self-hosted alike: registers the workers as OpenIddict
      authorization_code clients, fixes cold-start SSO on the management API
      authorize endpoint (Cloud), and keeps MCP sessions alive across backoffice
      logins without disabling single-session enforcement globally.
    </Description>
    <PackageTags>umbraco;mcp;oauth;openiddict;umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings Umbraco.Cms.Core/Web.Common, UserLoginSuccessNotification, and the
         OpenIddict abstractions (IOpenIddictApplicationManager / IOpenIddictTokenManager)
         transitively. This is the Umbraco 18 line; the 17 line lives on the
         v17/main branch. Every API this package consumes is unchanged from 17.3.0
         through 18.x (verified against release-18.0.2); min-bounded so the
         consuming project's CMS version wins. -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.0.0, 19.0.0)" />
  </ItemGroup>

</Project>
